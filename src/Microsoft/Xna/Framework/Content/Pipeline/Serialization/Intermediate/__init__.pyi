from typing import Any, Callable, Generic, TextIO, TypeVar, overload
from .... import ContentSerializerAttribute
from ... import ExternalReferenceOfT

T = TypeVar("T")

class ContentTypeSerializer:
    @overload
    def __init__(self, targetType: type) -> None: ...
    @overload
    def __init__(self, targetType: type, xmlTypeName: str) -> None: ...
    def Initialize(self, serializer: IntermediateSerializer) -> None: ...
    def Serialize(self, output: IntermediateWriter, value: object, format: ContentSerializerAttribute) -> None: ...
    def Deserialize(self, input: IntermediateReader, format: ContentSerializerAttribute, existingInstance: object) -> object: ...
    def ObjectIsEmpty(self, value: object) -> bool: ...
    def ScanChildren(self, serializer: IntermediateSerializer, callback: ContentTypeSerializer.ChildCallback, value: object) -> None: ...
    @property
    def TargetType(self) -> type: ...
    @property
    def XmlTypeName(self) -> str: ...
    @property
    def CanDeserializeIntoExistingObject(self) -> bool: ...
    class ChildCallback:
        def __init__(self, object: object, method: int) -> None: ...
        def Invoke(self, typeSerializer: ContentTypeSerializer, value: object) -> None: ...
        def BeginInvoke(self, typeSerializer: ContentTypeSerializer, value: object, callback: Callable[[object], None], object: object) -> object: ...
        def EndInvoke(self, result: object) -> None: ...

class ContentTypeSerializerAttribute:
    def __init__(self) -> None: ...

class ContentTypeSerializerOfT(ContentTypeSerializer, Generic[T]):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, xmlTypeName: str) -> None: ...
    @overload
    def Serialize(self, output: IntermediateWriter, value: T, format: ContentSerializerAttribute) -> None: ...
    @overload
    def Serialize(self, output: IntermediateWriter, value: object, format: ContentSerializerAttribute) -> None: ...
    @overload
    def Deserialize(self, input: IntermediateReader, format: ContentSerializerAttribute, existingInstance: T) -> T: ...
    @overload
    def Deserialize(self, input: IntermediateReader, format: ContentSerializerAttribute, existingInstance: object) -> object: ...
    @overload
    def ObjectIsEmpty(self, value: T) -> bool: ...
    @overload
    def ObjectIsEmpty(self, value: object) -> bool: ...
    @overload
    def ScanChildren(self, serializer: IntermediateSerializer, callback: ContentTypeSerializer.ChildCallback, value: T) -> None: ...
    @overload
    def ScanChildren(self, serializer: IntermediateSerializer, callback: ContentTypeSerializer.ChildCallback, value: object) -> None: ...

class IntermediateReader:
    @overload
    def ReadObject(self, format: ContentSerializerAttribute) -> T: ...
    @overload
    def ReadObject(self, format: ContentSerializerAttribute, existingInstance: T) -> T: ...
    @overload
    def ReadObject(self, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer) -> T: ...
    @overload
    def ReadObject(self, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer, existingInstance: T) -> T: ...
    @overload
    def ReadRawObject(self, format: ContentSerializerAttribute) -> T: ...
    @overload
    def ReadRawObject(self, format: ContentSerializerAttribute, existingInstance: T) -> T: ...
    @overload
    def ReadRawObject(self, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer) -> T: ...
    @overload
    def ReadRawObject(self, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer, existingInstance: T) -> T: ...
    def ReadSharedResource(self, format: ContentSerializerAttribute, fixup: Callable[[T], None]) -> None: ...
    def ReadExternalReference(self, existingInstance: ExternalReferenceOfT[T]) -> None: ...
    def ReadTypeName(self) -> type: ...
    def MoveToElement(self, elementName: str) -> bool: ...
    @property
    def Serializer(self) -> IntermediateSerializer: ...
    @property
    def Xml(self) -> TextIO: ...

class IntermediateSerializer:
    @staticmethod
    def Serialize(output: TextIO, value: T, referenceRelocationPath: str) -> None: ...
    @staticmethod
    def Deserialize(input: TextIO, referenceRelocationPath: str, *, targetType: type[T]) -> T: ...
    def GetTypeSerializer(self, type: type) -> ContentTypeSerializer: ...

class IntermediateWriter:
    @overload
    def WriteObject(self, value: T, format: ContentSerializerAttribute) -> None: ...
    @overload
    def WriteObject(self, value: T, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer) -> None: ...
    @overload
    def WriteRawObject(self, value: T, format: ContentSerializerAttribute) -> None: ...
    @overload
    def WriteRawObject(self, value: T, format: ContentSerializerAttribute, typeSerializer: ContentTypeSerializer) -> None: ...
    def WriteSharedResource(self, value: T, format: ContentSerializerAttribute) -> None: ...
    def WriteExternalReference(self, value: ExternalReferenceOfT[T]) -> None: ...
    def WriteTypeName(self, type: type) -> None: ...
    @property
    def Serializer(self) -> IntermediateSerializer: ...
    @property
    def Xml(self) -> TextIO: ...
